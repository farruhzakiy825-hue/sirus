   G_LVP_GRID_DOCTOR = "GRID DOCTOR: initializing";
   G_LVP_GATE_STACK = "GATE STACK: initializing";
   G_LVP_DETAIL = "LVP DETAIL: initializing";
   G_LVP_LAST_SIGNATURE = "";
